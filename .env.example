# ═══════════════════════════════════════════════════════════════════════════════
# MovieBuzz Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────
# DATABASE CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Database type: "mongodb"
DB_TYPE=mongodb

# MongoDB Connection String
# Format: mongodb+srv://username:password@cluster.mongodb.net/database
# Get from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/moviebuzz?retryWrites=true&w=majority

DATABASE_NAME=moviebuzz

# ─────────────────────────────────────────────────────────────────────────────
# API KEYS & EXTERNAL SERVICES
# ─────────────────────────────────────────────────────────────────────────────

# OMDb API Key (for movie metadata)
# Get from: https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your-omdb-key

# TMDb API Key (The Movie Database)
# Get from: https://www.themoviedb.org/settings/api
TMDB_API_KEY=your-tmdb-key

# ─────────────────────────────────────────────────────────────────────────────
# EMAIL CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# SMTP Server Configuration
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SSL_PORT=465
SMTP_TIMEOUT=15
SMTP_USER=moviebuzzspm@zohomail.in
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=moviebuzzspm@zohomail.in

# Support Email
SUPPORT_EMAIL=moviebuzzspm@zohomail.in

# MongoDB timeouts for Atlas and shared clusters
MONGO_CONNECT_TIMEOUT_MS=30000
MONGO_SOCKET_TIMEOUT_MS=60000
MONGO_SERVER_SELECTION_TIMEOUT_MS=30000
MOVIEBUZZ_IMPORT_MAX_MOVIES=7000
MOVIEBUZZ_IMPORT_MAX_RATINGS=500000
MOVIEBUZZ_IMPORT_INCLUDE_GENOME=0
MOVIEBUZZ_IMPORT_PERSIST_TAGS=0
MOVIEBUZZ_IMPORT_PERSIST_RATING_TIMESTAMPS=0

# ─────────────────────────────────────────────────────────────────────────────
# FRONTEND & AUTHENTICATION
# ─────────────────────────────────────────────────────────────────────────────

# Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
# For production: FRONTEND_URL=https://moviebuzz-frontend.onrender.com

# Secret key for session/JWT signing
SECRET_KEY=your-super-secret-key-change-in-production

# Admin accounts (JSON format)
MOVIEBUZZ_SYSTEM_ADMIN_ACCOUNTS_JSON=[{"name":"Admin","email":"admin@example.com","password":"change-me"}]

# ─────────────────────────────────────────────────────────────────────────────
# ML MODEL & DATA CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# Data directory (MovieLens CSV files)
MOVIEBUZZ_DATA_DIR=./backend/data

# OMDB Cache Settings
MOVIEBUZZ_OMDB_TIMEOUT=5
MOVIEBUZZ_OMDB_MEMORY_CACHE_TTL_SECONDS=21600  # 6 hours
MOVIEBUZZ_OMDB_MEMORY_CACHE_MAX_ITEMS=2048
MOVIEBUZZ_OMDB_PREFETCH_BATCH_SIZE=25
MOVIEBUZZ_OMDB_PREFETCH_WORKERS=4

# Feature Flags
MOVIEBUZZ_SKIP_STARTUP=0      # Set to 1 to skip model loading on startup
MOVIEBUZZ_AUTO_LOAD_DATA=0    # Set to 1 only when you intentionally want startup to import MovieLens into MongoDB
MOVIEBUZZ_WARM_ENGINE=0       # Set to 1 to load ML models on startup
MOVIEBUZZ_DEV=1               # Set to 1 for development (allows all CORS origins)

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT & RUNTIME
# ─────────────────────────────────────────────────────────────────────────────

# Environment
MOVIEBUZZ_ENV=development  # development, staging, production

# Render.com flag (auto-detected)
RENDER=false

# Logging level
MOVIEBUZZ_LOG_LEVEL=INFO  # DEBUG, INFO, WARNING, ERROR

# ═══════════════════════════════════════════════════════════════════════════════
# NOTES FOR LOCAL DEVELOPMENT
# ═══════════════════════════════════════════════════════════════════════════════
#
# 1. MongoDB Local (Docker):
#    docker run -d -p 27017:27017 --name moviebuzz-mongo mongo:latest
#    MONGODB_URI=mongodb://localhost:27017/moviebuzz
#
# 2. MongoDB Atlas (Cloud):
#    Create free cluster: https://www.mongodb.com/cloud/atlas
#    Use connection string from "Connect" button
#
# 3. SMTP password note:
#    If your platform stores the value with quotes or a trailing "\n",
#    MovieBuzz will normalize that before SMTP login.
#
# 4. OMDb API Key:
#    Free tier: 1000 requests/day
#    Check email confirmation if key doesn't work
#
# ═══════════════════════════════════════════════════════════════════════════════
