# MovieBuzz Frontend - Environment Configuration Example

# API BASE URL
# Development: Backend running locally
VITE_API_URL=http://localhost:8000

# Production: Replace with your Render backend URL
# VITE_API_URL=https://moviebuzz-backend.onrender.com

# Feature Flags
VITE_ENABLE_MOOD_BROWSE=true
VITE_ENABLE_ADMIN_PANEL=true
VITE_ENABLE_PREFERENCES=true
VITE_ENABLE_WISHLIST=true

# Optional: Third-party integrations
# VITE_ANALYTICS_KEY=your_analytics_key_here
# VITE_SENTRY_DSN=your_sentry_dsn_here

# Optional: Branding
# VITE_APP_NAME=MovieBuzz
# VITE_APP_LOGO_URL=https://yourdomain.com/logo.png
