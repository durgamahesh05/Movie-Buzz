# Core paths
DATABASE_URL=./moviebuzz.db
MOVIEBUZZ_DATA_DIR=./data

# FastAPI startup flags
MOVIEBUZZ_SKIP_STARTUP=0
MOVIEBUZZ_WARM_ENGINE=0

# Zoho SMTP
SMTP_HOST=smtp.zoho.in
SMTP_PORT=587
SMTP_SSL_PORT=465
SMTP_USER=your_zoho_mailbox@zohomail.in
SMTP_PASSWORD=your_zoho_app_password
SMTP_FROM=your_zoho_mailbox@zohomail.in
SUPPORT_EMAIL=your_zoho_mailbox@zohomail.in
SMTP_TIMEOUT=15

# Movie metadata APIs
OMDB_API_KEY=your_omdb_api_key
TMDB_API_KEY=your_tmdb_api_key

# Optional admin bootstrap for local/dev only
# JSON array of objects with name, email, and password keys.
# Example:
# MOVIEBUZZ_SYSTEM_ADMIN_ACCOUNTS_JSON=[{"name":"Admin","email":"admin@example.com","password":"change_me"}]
MOVIEBUZZ_SYSTEM_ADMIN_ACCOUNTS_JSON=

# Optional future / deployment placeholders
# YOUTUBE_API_KEY=your_youtube_api_key
# JWT_SECRET_KEY=replace_with_a_long_random_secret

# Training and retraining flags
FORCE_RETRAIN=0
FORCE_XGB_RETRAIN=0
TRAIN_USE_GPU=1
XGB_ENABLE_RANK_OBJECTIVE=0

# Sampling and model hyperparameters
SVD_SAMPLE_ROWS=10000000
ALS_SAMPLE_ROWS=5000000
NCF_SAMPLE_ROWS=600000
XGB_SAMPLE_ROWS=500000
NCF_NEG_RATIO=10
NCF_POSITIVE_RATING=4.0
NCF_EPOCHS=60
NCF_EMBED_DIM=96
NCF_DROPOUT=0.35
NCF_BATCH_SIZE=4096
NCF_PATIENCE=5
SVD_N_FACTORS=150
SVD_N_EPOCHS=30
SVD_LR_ALL=0.007
SVD_REG_ALL=0.02
XGB_VALIDATION_RATIO=0.2
XGB_EARLY_STOPPING_ROUNDS=40
XGB_MAX_GENRE_FEATURES=24
XGB_GENOME_TOP_TAGS=10
EVAL_SAMPLE_ROWS=250000

# Metadata cache tuning
MOVIEBUZZ_OMDB_TIMEOUT=5
MOVIEBUZZ_TMDB_TIMEOUT=5
MOVIEBUZZ_OMDB_MEMORY_CACHE_TTL_SECONDS=21600
MOVIEBUZZ_OMDB_MEMORY_CACHE_MAX_ITEMS=2048
MOVIEBUZZ_OMDB_PREFETCH_BATCH_SIZE=25
MOVIEBUZZ_OMDB_PREFETCH_WORKERS=4
