{
  "venvPath": "./backend",
  "venv": ".venv",
  "extraPaths": ["./backend"],
  "typeCheckingMode": "basic",
  "exclude": [
    "**/.*",
    "**/.git",
    "**/.hg",
    "**/.svn",
    "**/CVS",
    "**/.venv",
    "**/node_modules",
    "**/__pycache__"
  ],
  "ignore": [
    "backend/.venv"
  ],
  "executionEnvironments": [
    {
      "root": "./backend",
      "extraPaths": [
        "./backend"
      ]
    }
  ],
  "reportOptionalSubscript": "none",
  "reportGeneralTypeIssues": "warning",
  "reportOptionalMemberAccess": "warning",
  "reportAttributeAccessIssue": "warning"
}
